# Copy into Dokploy Environment or an operator-owned file outside the checkout.
# Generate a URL-safe database password with: openssl rand -hex 32
CLOUD_DATABASE_PASSWORD=replace-with-a-random-hex-password

# Complete image references; can also be replaced with private ACR/Harbor images.
NODE_IMAGE=m.daocloud.io/docker.io/library/node:24-bookworm-slim
POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:17-bookworm
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
NPM_REGISTRY=https://registry.npmmirror.com

# Real credentials belong only in the deployment environment, never in Git.
OSS_BUCKET=your-private-bucket
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_PREFIX=your-dedicated-prefix/
OSS_ACCESS_KEY_ID=replace-with-operator-key-id
OSS_ACCESS_KEY_SECRET=replace-with-operator-key-secret
OSS_CNAME=false
CLOUD_QUOTA_BYTES=10000000000
CLOUD_FILE_BYTES=2000000000
CLOUD_SNAPSHOT_BYTES=5000000000
CLOUD_PART_BYTES=8388608
CLOUD_UPLOAD_SECONDS=86400
CLOUD_CLEANUP_SECONDS=300
